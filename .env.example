NODE_ENV=development
PORT=3000

# Local Postgres in Docker:
#   docker run -d --name voice-feedback-db -p 5432:5432 -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=voice_feedback postgres:17
# Supabase: use the session pooler string (port 5432) from Project Settings > Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voice_feedback

BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
# In dev the Vite proxy forwards /api to this server, so both URLs are the client origin
BETTER_AUTH_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
RESEND_API_KEY=
EMAIL_FROM=Voiceflow <hi@your-domain.com>

# Audio storage, any S3-compatible service.
# AWS S3: leave S3_ENDPOINT empty and set S3_REGION.
# Supabase: Project Settings > Storage > S3 Connection (endpoint, region, access keys), S3_FORCE_PATH_STYLE=true
# Local Docker: docker run -d -p 9000:9000 -p 9001:9001 -e MINIO_ROOT_USER=minio -e MINIO_ROOT_PASSWORD=minio12345 minio/minio server /data --console-address ":9001"
#   then S3_ENDPOINT=http://localhost:9000, S3_FORCE_PATH_STYLE=true and the root user/password as the keys
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=feedback-audio
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Speech to text (Sarvam) and sentiment (OpenRouter). Not needed when SARVAM_API_KEY=
OPENROUTER_API_KEY=
SENTIMENT_MODEL=openai/gpt-4o-mini

# Inngest: INNGEST_DEV=1 in development (local dev server); the two keys are production only.
INNGEST_DEV=
# Dev server: run `npx inngest-cli@latest dev -u http://localhost:3000/api/inngest`.
# Production only:
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
