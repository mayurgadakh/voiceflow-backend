NODE_ENV=development
PORT=3000

# Local Postgres in Docker:
#   docker run -d --name voice-feedback-db -p 5432:5432 -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=voice_feedback postgres:17
# Supabase: use the session pooler string (port 5432) from Project Settings > Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voice_feedback

BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
# In dev the Vite proxy forwards /api to this server, so both URLs are the client origin
BETTER_AUTH_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
RESEND_API_KEY=
EMAIL_FROM=Voice Feedback <hi@your-domain.com>
